rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isWorkflowOwner(workflowData) {
      return isSignedIn() && request.auth.uid == workflowData.ownerId;
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Workflows
    match /workflows/{workflowId} {
      allow read: if isSignedIn(); // For now, internal platform access
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isWorkflowOwner(resource.data);
    }

    // Tasks
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // Could be more restrictive based on assignment
    }

    // Logs
    match /logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }
  }
}
